{
  "$id": "https://schemas.kizunasync.dev/decisions-index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {
    "additionalProperties": false,
    "properties": {
      "file": {
        "pattern": "^decisions/D-[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.md$",
        "type": "string"
      },
      "status": {
        "enum": [
          "decided",
          "open",
          "superseded"
        ],
        "type": "string"
      },
      "title": {
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "file",
      "status",
      "title"
    ],
    "type": "object"
  },
  "kizunaCites": [
    "P:the-golden-corpus-and-deterministic-placeholders"
  ],
  "kizunaNote": "decisions/index.json: generated by tools/build-decisions-index.ts from decisions/D-*.md. Keys are D-<kebab-slug> ids; harness I-7 reads these keys.",
  "kizunaStatus": "normative",
  "propertyNames": {
    "pattern": "^D-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
  },
  "type": "object"
}
