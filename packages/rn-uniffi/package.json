{
  "name": "@kizunasync/rn-uniffi",
  "version": "0.2.6-alpha.1",
  "license": "Apache-2.0",
  "author": "Kizuna Sync",
  "description": "UniFFI Turbo Module for kizunasync-ffi (ubrn). Not named @kizunasync/expo: ubrn derives the ObjC class from the package name and Expo.mm would collide with the Expo SDK.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kizunasync/kizunasync.git",
    "directory": "packages/rn-uniffi"
  },
  "homepage": "https://kizunasync.com/docs/reference/expo/rust-engine",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "ios",
    "android",
    "RnUniffi.podspec",
    "ubrn.config.yaml",
    "README.md",
    "!android/build",
    "!ios/build",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "type-check": "tsc -p tsconfig.json",
    "ubrn:ios": "IPHONEOS_DEPLOYMENT_TARGET=$(bash ../../scripts/swift-package/ios-floor.sh ios) && export IPHONEOS_DEPLOYMENT_TARGET && ubrn build ios --and-generate --config ubrn.config.yaml",
    "ubrn:android": "ubrn build android --and-generate --config ubrn.config.yaml"
  },
  "codegenConfig": {
    "name": "NativeRnUniffi",
    "type": "modules",
    "jsSrcsDir": "src/generated",
    "android": {
      "javaPackageName": "com.kizunasync.rnuniffi"
    }
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-6",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "peerDependencies": {
    "react-native": ">=0.86.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "react-native": "0.87.1",
    "typescript": "~7.0.2"
  }
}
