{
  "name": "@kizunasync/react",
  "version": "0.2.6-alpha.3",
  "private": true,
  "description": "Kizuna React bindings: a context Provider plus hooks (useKizunaSync, useQuery, useMutation, useSyncStatus, useAttachment, useRejections, useOverwrites) over the @kizunasync/core local-first client. Hybrid: Provider for ergonomics, an explicit { client } override on every hook.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kizunasync/kizunasync.git",
    "directory": "packages/react"
  },
  "homepage": "https://kizunasync.com/docs/reference/react/introduction",
  "keywords": ["supabase", "offline-first", "local-first", "sync", "sqlite", "react"],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test",
    "type-check": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kizunasync/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~7.0.2"
  }
}
