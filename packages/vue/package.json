{
  "name": "@kizunasync/vue",
  "version": "0.2.6-alpha.2",
  "description": "Kizuna Vue 3 bindings: a provide/inject Provider for ergonomics plus an optional explicit { client } override on every composable (the TanStack-Query hybrid). Reactivity rides kizunasync.on; reads come from the local store.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kizunasync/kizunasync.git",
    "directory": "packages/vue"
  },
  "homepage": "https://kizunasync.com/docs/reference/vue/introduction",
  "keywords": ["supabase", "offline-first", "local-first", "sync", "sqlite", "vue"],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test",
    "type-check": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kizunasync/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.19.0",
    "typescript": "~7.0.2",
    "vue": "^3.5.43"
  }
}
