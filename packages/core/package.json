{
  "name": "@kizunasync/core",
  "version": "0.2.6-alpha.1",
  "description": "Kizuna sync engine: the createKizunaSync app client over the Rust core, with the wire contracts, ports and host pieces it runs on. Conforms to the @kizunasync/protocol golden corpus; zero hard-coded domain tables.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kizunasync/kizunasync.git",
    "directory": "packages/core"
  },
  "homepage": "https://kizunasync.com/docs/reference/javascript/introduction",
  "keywords": ["supabase", "offline-first", "local-first", "sync", "sqlite"],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config/index.ts",
    "./constants": "./src/constants.ts",
    "./testing": "./src/testing/index.ts",
    "./conformance": "./src/conformance/index.ts"
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./config": {
        "types": "./dist/config/index.d.ts",
        "default": "./dist/config/index.js"
      },
      "./constants": {
        "types": "./dist/constants.d.ts",
        "default": "./dist/constants.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    },
    "optionalDependencies": {
      "@kizunasync/napi-darwin-arm64": "*",
      "@kizunasync/napi-darwin-x64": "*",
      "@kizunasync/napi-linux-x64-gnu": "*",
      "@kizunasync/napi-linux-arm64-gnu": "*",
      "@kizunasync/napi-win32-x64-msvc": "*"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test",
    "clean": "rm -rf dist",
    "check:gen-errors": "bun scripts/gen-engine-errors.ts && git diff --exit-code -- src/wire/engine-error-codes.generated.ts",
    "gen:errors": "bun scripts/gen-engine-errors.ts",
    "type-check": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "adze": "^2.3.0"
  },
  "devDependencies": {
    "@kizunasync/protocol": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.19.0",
    "typescript": "~7.0.2"
  }
}
