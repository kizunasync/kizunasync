# Kizuna Sync monorepo environment template. Copy to .env:
#
#   cp .env.example .env
#
# Every product reads the repo-root files (apps do not keep their own .env).
# Names are product-prefixed so website, demo, inspector, and examples can
# share one file. Paste the values `bun run db:status` prints once the local
# stack is running (this CLI issues sb_publishable_*/sb_secret_* keys).
# Local-dev only, never a production value (CONVENTIONS.md).
#
# Production reference values live in gitignored .env.prod. Machine-local
# overrides (LAN IP for Expo, website localhost origin) go in .env.local.

# --- Local Supabase stack (packages/supabase-pack, ports 55xxx) ---
# Shared by tests and supabase-pack. Product apps use the prefixed copies below.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Website (apps/website) ---
# Canonical origin for <link rel="canonical">, sitemap.xml, and JSON-LD.
# Unset defaults to https://kizunasync.com in apps/website/lib/site.ts.
NEXT_PUBLIC_WEBSITE_SITE_URL=http://localhost:3000
# Optional Google Tag Manager container ID. Empty loads no tags, so local runs
# send nothing to Google.
NEXT_PUBLIC_WEBSITE_GTM_ID=
# Optional. Out-of-tree builds where /docs markdown cannot be found by walking
# up to turbo.json. Leave unset inside the monorepo.
# KIZUNASYNC_REPO_ROOT=/absolute/path/to/repo
# Feedback form (app/api/feedback): all reads happen at request time, so the
# route stays green with these unset (503 + friendly fallback).
# WEBSITE_CLICKUP_API_TOKEN=pk_your_clickup_api_token
# WEBSITE_CLICKUP_CONTACT_LIST_ID=your_clickup_list_id
# WEBSITE_CLICKUP_WORKSPACE_ID=your_clickup_workspace_id
# WEBSITE_CLICKUP_CONTACT_CHANNEL_ID=your_clickup_chat_channel_id
# WEBSITE_TURNSTILE_SECRET_KEY=0x_your_turnstile_secret_key
# NEXT_PUBLIC_WEBSITE_TURNSTILE_SITE_KEY=0x_your_turnstile_site_key
# Optional. Self-hosted deploys with no trusted reverse proxy: collapse per-IP
# rate-limit buckets so a caller cannot spoof x-real-ip / x-forwarded-for.
# WEBSITE_TRUST_PROXY_HEADERS=false

# --- Demo (apps/demo, demo.kizunasync.com) ---
VITE_DEMO_SUPABASE_URL=
VITE_DEMO_SUPABASE_PUBLISHABLE_KEY=
# Optional Cloudflare Turnstile site key. Unset hides the widget; the local
# stack does not require one.
# VITE_DEMO_TURNSTILE_SITE_KEY=
# Optional Google Tag Manager container ID. Empty loads no tags.
VITE_DEMO_GTM_ID=

# --- Inspector (apps/sync-inspector) ---
# Server-only secret key: never give this a NEXT_PUBLIC_ prefix.
INSPECTOR_SUPABASE_URL=
INSPECTOR_SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_INSPECTOR_SUPABASE_URL=
NEXT_PUBLIC_INSPECTOR_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_INSPECTOR_SUPABASE_ANON_KEY is also read as an alias of the
# publishable key.

# --- Todo React (examples/todo-react) ---
VITE_TODO_REACT_SUPABASE_URL=
VITE_TODO_REACT_SUPABASE_PUBLISHABLE_KEY=

# --- Todo Vue (examples/todo-vue) ---
VITE_TODO_VUE_SUPABASE_URL=
VITE_TODO_VUE_SUPABASE_PUBLISHABLE_KEY=

# --- Todo Expo (examples/todo-expo) ---
# Simulator / web: 127.0.0.1. Physical device: the Mac's LAN IP, e.g.
# http://192.168.1.42:55321. Override that host in .env.local.
EXPO_PUBLIC_TODO_EXPO_SUPABASE_URL=
EXPO_PUBLIC_TODO_EXPO_SUPABASE_PUBLISHABLE_KEY=
# EXPO_PUBLIC_TODO_EXPO_SUPABASE_ANON_KEY is also read as an alias.
# Optional Cloudflare Turnstile site key. Set it only to run against the public
# demo project; it turns on the public demo profile (see the example README).
# EXPO_PUBLIC_TODO_EXPO_TURNSTILE_SITE_KEY=
# Apple Developer Team ID, only for EAS or `expo run:ios --device`.
TODO_EXPO_APPLE_TEAM_ID=
