{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // Tests are excluded (apps/website does the same): their bun types augment the
  // global fetch, which then stops matching supabase-js's own `typeof fetch`.
  "include": ["src"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
