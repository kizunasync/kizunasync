{
  "version": 1,
  "scenarios": [
    {
      "id": "insert-search-filter",
      "description": "Insert one row and match with local search filter",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-search-1",
          "columns": { "title": "Alpha", "user_id": "u1", "rank": 2 }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "search", "query": "alp" }],
            "cardinality": "many"
          },
          "expect_count": 1
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "search", "query": "zzz" }],
            "cardinality": "many"
          },
          "expect_count": 0
        }
      ]
    },
    {
      "id": "single-cardinality",
      "description": "single() returns one object",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-single-1",
          "columns": { "title": "Only", "user_id": "u1" }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "title", "value": "Only" }],
            "cardinality": "single"
          },
          "expect_single_title": "Only"
        }
      ]
    },
    {
      "id": "single-over-zero-rows-fails",
      "description": "fail-loud: single() over a filter that matches no row is a constraint refusal, never an empty answer",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-single-zero-1",
          "columns": { "title": "Only", "user_id": "u1" }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "title", "value": "Absent" }],
            "cardinality": "single"
          },
          "expect_error": true,
          "expect_code": "LOCAL_CONSTRAINT"
        }
      ]
    },
    {
      "id": "maybe-single-missing-is-null",
      "description": "maybeSingle() with no match returns null, not an error",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-maybe-1",
          "columns": { "title": "Present", "user_id": "u1" }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "title", "value": "Absent" }],
            "cardinality": "maybeSingle"
          },
          "expect_null": true
        }
      ]
    },
    {
      "id": "update-via-apply",
      "description": "update merges columns onto the existing row; stale value no longer matches",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-upd-insert",
          "columns": { "title": "Before", "user_id": "u1", "done": false }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "update",
          "mutation_id": "m-upd-update",
          "columns": { "title": "After" }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "title", "value": "After" }],
            "cardinality": "single"
          },
          "expect_single_title": "After"
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "title", "value": "Before" }],
            "cardinality": "many"
          },
          "expect_count": 0
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "done", "value": false }],
            "cardinality": "many"
          },
          "expect_count": 1
        }
      ]
    },
    {
      "id": "delete-via-apply-tombstone-absence",
      "description": "delete removes the row from local reads; tombstone is visible as absence",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-del-insert-1",
          "columns": { "title": "Keep", "user_id": "u1" }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p2",
          "mutation_op": "insert",
          "mutation_id": "m-del-insert-2",
          "columns": { "title": "Drop", "user_id": "u1" }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p2",
          "mutation_op": "delete",
          "mutation_id": "m-del-delete-2"
        },
        {
          "op": "query",
          "table": "items",
          "plan": { "cardinality": "many" },
          "expect_count": 1
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "id", "value": "p2" }],
            "cardinality": "many"
          },
          "expect_count": 0
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "id", "value": "p1" }],
            "cardinality": "single"
          },
          "expect_single_title": "Keep"
        }
      ]
    },
    {
      "id": "filters-eq-neq-in-like",
      "description": "eq / neq / in / like narrow the local result set",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-filter-1",
          "columns": { "title": "Apple", "status": "open", "user_id": "u1" }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p2",
          "mutation_op": "insert",
          "mutation_id": "m-filter-2",
          "columns": { "title": "Apricot", "status": "done", "user_id": "u1" }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p3",
          "mutation_op": "insert",
          "mutation_id": "m-filter-3",
          "columns": { "title": "Banana", "status": "open", "user_id": "u1" }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "status", "value": "open" }],
            "cardinality": "many"
          },
          "expect_count": 2
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "neq", "column": "status", "value": "open" }],
            "cardinality": "single"
          },
          "expect_single_title": "Apricot"
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "in", "column": "id", "values": ["p1", "p3"] }],
            "orders": [{ "column": "title", "ascending": true }],
            "cardinality": "many"
          },
          "expect_column_values": { "column": "title", "values": ["Apple", "Banana"] }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "like", "column": "title", "pattern": "Ap%" }],
            "orders": [{ "column": "title", "ascending": true }],
            "cardinality": "many"
          },
          "expect_column_values": { "column": "title", "values": ["Apple", "Apricot"] }
        }
      ]
    },
    {
      "id": "order-and-limit",
      "description": "orders + limit are applied after filtering, ascending and descending",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-order-1",
          "columns": { "title": "Charlie", "rank": 3, "user_id": "u1" }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p2",
          "mutation_op": "insert",
          "mutation_id": "m-order-2",
          "columns": { "title": "Alpha", "rank": 1, "user_id": "u1" }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p3",
          "mutation_op": "insert",
          "mutation_id": "m-order-3",
          "columns": { "title": "Bravo", "rank": 2, "user_id": "u1" }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "orders": [{ "column": "rank", "ascending": true }],
            "cardinality": "many"
          },
          "expect_column_values": {
            "column": "title",
            "values": ["Alpha", "Bravo", "Charlie"]
          }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "orders": [{ "column": "rank", "ascending": false }],
            "limit": 2,
            "cardinality": "many"
          },
          "expect_column_values": { "column": "title", "values": ["Charlie", "Bravo"] }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "orders": [{ "column": "rank", "ascending": true }],
            "limit": 1,
            "cardinality": "many"
          },
          "expect_count": 1
        }
      ]
    },
    {
      "id": "outbox-depth-after-applies",
      "description": "every accepted local mutation enqueues exactly one outbox entry",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        { "op": "outbox_depth", "expect_depth": 0 },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-depth-1",
          "columns": { "title": "One", "user_id": "u1" }
        },
        { "op": "outbox_depth", "expect_depth": 1 },
        {
          "op": "apply",
          "table": "items",
          "pk": "p2",
          "mutation_op": "insert",
          "mutation_id": "m-depth-2",
          "columns": { "title": "Two", "user_id": "u1" }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "update",
          "mutation_id": "m-depth-3",
          "columns": { "title": "One-Updated" }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p2",
          "mutation_op": "delete",
          "mutation_id": "m-depth-4"
        },
        { "op": "outbox_depth", "expect_depth": 4 }
      ]
    },
    {
      "id": "sync-drains-outbox",
      "description": "sync against the default ScriptedRemote auto-applies verdicts and clears the outbox",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-sync-1",
          "columns": { "title": "Pending", "user_id": "u1" }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p2",
          "mutation_op": "insert",
          "mutation_id": "m-sync-2",
          "columns": { "title": "AlsoPending", "user_id": "u1" }
        },
        { "op": "outbox_depth", "expect_depth": 2 },
        { "op": "sync" },
        { "op": "outbox_depth", "expect_depth": 0 },
        {
          "op": "query",
          "table": "items",
          "plan": { "cardinality": "many" },
          "expect_count": 2
        }
      ]
    },
    {
      "id": "apply-unknown-table-fails",
      "description": "fail-loud: a mutation against a table absent from the config is rejected",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "ghosts",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-unknown-1",
          "columns": { "title": "Nope" },
          "expect_error": true,
          "expect_code": "UNKNOWN_TABLE"
        },
        { "op": "outbox_depth", "expect_depth": 0 }
      ]
    },
    {
      "id": "insert-duplicate-pk-fails",
