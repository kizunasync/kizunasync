    {
      "id": "update-absent-row-queues-the-write",
      "description": "an update whose row is absent locally (never created, or deleted by a peer) still queues: the masked columns become the local row and the server decides. Parity with Op::Update in crates/kizunasync-store/src/store/rows.rs, refusing it locally would strand the queued write (conflict-vectors.json update_over_tombstone)",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "missing",
          "mutation_op": "update",
          "mutation_id": "m-missing-1",
          "columns": { "title": "Ghost" }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "id", "value": "missing" }],
            "cardinality": "single"
          },
          "expect_single_title": "Ghost"
        },
        { "op": "outbox_depth", "expect_depth": 1 }
      ]
    },
    {
      "id": "increment-via-update-transform",
      "description": "an update transform increment is an D-field-transforms field delta on update, not a fourth op; local rank advances by the delta",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-inc-1",
          "columns": { "title": "Score", "user_id": "u1", "rank": 1 }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "update",
          "mutation_id": "m-inc-2",
          "columns": {},
          "transforms": { "rank": { "op": "increment", "by": 2 } }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "title", "value": "Score" }],
            "cardinality": "many"
          },
          "expect_column_values": { "column": "rank", "values": [3] }
        }
      ]
    },
    {
      "id": "apply-where-updates-matching-rows",
