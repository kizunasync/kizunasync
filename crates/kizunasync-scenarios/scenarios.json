    },
    {
      "id": "checkpoint-and-empty-rejections",
      "description": "a fresh engine has an empty rejection journal; seed_checkpoint then checkpoint round-trips the cursor",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        { "op": "rejections", "expect_count": 0 },
        { "op": "seed_checkpoint", "cursor": "c-seed-1" },
        { "op": "checkpoint", "expect_cursor": "c-seed-1" }
      ]
    },
    {
      "id": "soft-delete-hides-the-row",
      "description": "a filter-targeted delete on a soft-delete table marks the row: it leaves every read until the plan asks for includeDeleted, and it is no write target either",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" },
              "soft_delete_column": "deleted_at"
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-soft-1",
          "columns": { "title": "Alpha", "user_id": "u1" }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p2",
          "mutation_op": "insert",
          "mutation_id": "m-soft-2",
          "columns": { "title": "Bravo", "user_id": "u1" }
        },
        {
          "op": "apply_where",
          "table": "items",
          "mutation_op": "delete",
          "filters": [{ "kind": "eq", "column": "id", "value": "p1" }]
        },
        {
          "op": "query",
          "table": "items",
          "plan": { "cardinality": "many" },
          "expect_count": 1
        },
        {
          "op": "query",
          "table": "items",
          "plan": { "cardinality": "many", "includeDeleted": true },
          "expect_count": 2
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "id", "value": "p1" }],
