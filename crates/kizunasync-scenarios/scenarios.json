          },
          "expect_column_values": { "column": "id", "values": ["p1"] }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "id", "value": "p2" }],
            "cardinality": "single"
          },
          "expect_single_title": "Bravo"
        }
