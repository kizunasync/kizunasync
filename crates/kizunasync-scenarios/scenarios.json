      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-aw-1",
