        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-dup-2",
          "columns": { "title": "Second", "user_id": "u1" },
          "expect_error": true,
          "expect_code": "LOCAL_CONSTRAINT"
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "id", "value": "p1" }],
