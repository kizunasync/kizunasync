        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p2",
          "mutation_op": "insert",
          "mutation_id": "m-aw-2",
          "columns": { "title": "Shut", "user_id": "u1", "done": true }
        },
        {
          "op": "apply_where",
          "table": "items",
          "mutation_op": "update",
          "filters": [{ "kind": "eq", "column": "done", "value": false }],
          "columns": { "title": "Closed" }
        },
        {
          "op": "query",
          "table": "items",
          "plan": {
            "filters": [{ "kind": "eq", "column": "title", "value": "Closed" }],
            "cardinality": "many"
          },
          "expect_count": 1
        }
      ]
    },
    {
      "id": "apply-where-targets-by-id",
      "description": "apply_where targets rows by id: a row whose stored column map carries no id is still addressed by the id the query seam derives from its pk",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-awid-1",
          "columns": { "title": "Alpha", "user_id": "u1" }
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p2",
          "mutation_op": "insert",
          "mutation_id": "m-awid-2",
          "columns": { "title": "Bravo", "user_id": "u1" }
