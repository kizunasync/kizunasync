          },
          "expect_single_title": "Alpha"
        }
      ]
    },
    {
      "id": "pull-only-refuses-local-writes",
      "description": "fail-loud: a table the server owns takes no local write, and the refusal names the local subset rather than waiting for the server",
      "steps": [
        {
          "op": "create",
          "tables": {
            "announcements": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" },
              "sync_mode": "pull-only"
            },
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "apply",
          "table": "announcements",
          "pk": "a1",
          "mutation_op": "insert",
          "mutation_id": "m-pull-only-1",
          "columns": { "title": "Alpha", "user_id": "u1" },
          "expect_error": true,
          "expect_code": "LOCAL_UNSUPPORTED"
        },
        {
          "op": "query",
          "table": "announcements",
          "plan": { "cardinality": "many" },
          "expect_count": 0
        },
        {
          "op": "apply_where",
          "table": "announcements",
          "mutation_op": "update",
          "filters": [{ "kind": "eq", "column": "id", "value": "a1" }],
          "columns": { "title": "Bravo" },
          "expect_error": true,
          "expect_code": "LOCAL_UNSUPPORTED"
        },
        {
          "op": "apply",
          "table": "items",
          "pk": "p1",
          "mutation_op": "insert",
          "mutation_id": "m-pull-only-2",
          "columns": { "title": "Alpha", "user_id": "u1" }
        },
        { "op": "outbox_depth", "expect_depth": 1 }
      ]
    },
    {
      "id": "set-bucket-refuses-an-unconfigured-key",
      "description": "fail-loud: set_bucket takes only the columns some table declares as its bucket column, so a misspelled key refuses the whole call instead of routing on nothing",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "" }
            }
          }
        },
        {
          "op": "set_bucket",
          "params": { "tenant_id": "t1" },
          "expect_error": true,
          "expect_code": "BUCKET_UNSET"
        },
        { "op": "set_bucket", "params": { "user_id": "u1" } }
      ]
    },
    {
      "id": "attachment-budget-stops-a-failing-upload",
      "description": "an attachment gets the configured transfer attempts and no more: the claim past the budget is refused, the row lands permanently failed, and no later drive returns it",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "attachment_put",
          "attachment": {
            "reference": "u1/p1/photo.png",
            "upload_id": "photo",
            "table": "items",
            "pk": "p1",
            "column": "photo",
            "bucket": "media",
            "owner": "u1",
            "local_path": "/sandbox/photo.png",
            "direction": "upload",
            "state": "queued",
            "created_at": "2024-01-01T00:00:00.000Z"
          }
        },
        { "op": "attachment_pending", "direction": "upload", "expect_count": 1 },
        {
          "op": "attachment_fail_next",
          "reference": "u1/p1/photo.png",
          "expect_value": true
        },
        {
          "op": "attachment_fail_next",
          "reference": "u1/p1/photo.png",
          "expect_value": true
        },
        {
          "op": "attachment_fail_next",
          "reference": "u1/p1/photo.png",
          "expect_value": true
        },
        {
          "op": "attachment_fail_next",
          "reference": "u1/p1/photo.png",
          "expect_value": true
        },
        {
          "op": "attachment_fail_next",
          "reference": "u1/p1/photo.png",
          "expect_value": true
        },
        {
          "op": "attachment_status",
          "reference": "u1/p1/photo.png",
          "expect_status": { "state": "failed", "permanent": false }
        },
        {
          "op": "attachment_fail_next",
          "reference": "u1/p1/photo.png",
          "expect_value": false
        },
        {
          "op": "attachment_status",
          "reference": "u1/p1/photo.png",
          "expect_status": { "state": "failed", "permanent": true }
        },
        { "op": "attachment_pending", "direction": "upload", "expect_count": 0 }
      ]
    },
    {
      "id": "attachment-retry-forgives-the-budget",
      "description": "retry is the app taking a stopped attachment back: the budget is forgiven, the attempts start over, and the next drive sees the row again",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "attachment_put",
          "attachment": {
            "reference": "u1/p1/photo.png",
            "upload_id": "photo",
            "table": "items",
            "pk": "p1",
            "column": "photo",
            "bucket": "media",
            "owner": "u1",
            "local_path": "/sandbox/photo.png",
            "direction": "upload",
            "state": "failed",
            "created_at": "2024-01-01T00:00:00.000Z"
          }
        },
        {
          "op": "attachment_patch",
          "reference": "u1/p1/photo.png",
          "patch": { "attempts": 5, "permanent": true, "state": "failed" }
        },
        { "op": "attachment_pending", "direction": "upload", "expect_count": 0 },
        {
          "op": "attachment_retry",
          "reference": "u1/p1/photo.png",
          "expect_value": true
        },
        {
          "op": "attachment_status",
          "reference": "u1/p1/photo.png",
          "expect_status": { "state": "queued", "permanent": false }
        },
        { "op": "attachment_pending", "direction": "upload", "expect_count": 1 },
        {
          "op": "attachment_retry",
          "reference": "u1/p1/absent.png",
          "expect_value": false
        }
      ]
    },
    {
      "id": "attachment-cancel-keeps-the-row-retryable",
      "description": "cancel is the app saying not now, never never again: the transfer stops and the row stays a candidate, unlike the budget's own refusal",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "attachment_put",
          "attachment": {
            "reference": "u1/p1/photo.png",
            "upload_id": "photo",
            "table": "items",
            "pk": "p1",
            "column": "photo",
            "bucket": "media",
            "owner": "u1",
            "local_path": "/sandbox/photo.png",
            "direction": "upload",
            "state": "queued",
            "created_at": "2024-01-01T00:00:00.000Z"
          }
        },
        {
          "op": "attachment_cancel",
          "reference": "u1/p1/photo.png",
          "expect_value": true
        },
        {
          "op": "attachment_status",
          "reference": "u1/p1/photo.png",
          "expect_status": { "state": "failed", "permanent": false }
        },
        { "op": "attachment_pending", "direction": "upload", "expect_count": 1 },
        {
          "op": "attachment_cancel",
          "reference": "u1/p1/absent.png",
          "expect_value": false
        }
      ]
    },
    {
      "id": "attachment-remove-hands-back-the-sandbox-path",
      "description": "remove forgets the queue row and answers the sandbox path whose bytes the host still has to delete",
      "steps": [
        {
          "op": "create",
          "tables": {
            "items": {
              "bucket_column": "user_id",
              "bucket_params": { "user_id": "u1" }
            }
          }
        },
        {
          "op": "attachment_put",
          "attachment": {
            "reference": "u1/p1/photo.png",
            "upload_id": "photo",
            "table": "items",
            "pk": "p1",
            "column": "photo",
            "bucket": "media",
            "owner": "u1",
            "local_path": "/sandbox/photo.png",
            "direction": "upload",
            "state": "queued",
            "created_at": "2024-01-01T00:00:00.000Z"
          }
        },
        {
          "op": "attachment_remove",
          "reference": "u1/p1/photo.png",
          "expect_value": "/sandbox/photo.png"
        },
        {
          "op": "attachment_status",
          "reference": "u1/p1/photo.png",
          "expect_null": true
        },
        {
          "op": "attachment_remove",
          "reference": "u1/p1/photo.png",
          "expect_null": true
        }
      ]
    }
  ]
