*.dylib
*.dll
*.exe
*.profraw

# cbindgen output
bindings.h

###############################################################################
# RUST WASM (wasm-bindgen, cargo wasm)
###############################################################################

# wasm-bindgen (results and artifacts)
wasm-pack.log
.wasm-pack/

# wasm-bindgen output, built by `bun run cargo:wasm` locally and in the wasm-build job.
# The two generated .d.ts files beside them are committed: deterministic from the Rust source, and tsc needs them.
packages/web/src/wasm/kizunasync_wasm.js
packages/web/src/wasm/kizunasync_wasm_bg.wasm

